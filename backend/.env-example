# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (MongoDB)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=shortlinks

# Authentication & Security
# Generate secure random strings (minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_a_secure_random_jwt_access_secret_32_chars_min
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REMEMBER_REFRESH_MAX_AGE_MS=2592000000
BCRYPT_COST=10

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW=15m

# Email & Verification
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_TTL=24h
FRONTEND_BASE_URL=http://localhost:5173
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@shortlinks.local

# SMTP Settings (Required only when MAIL_TRANSPORT=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Shortlinks Configuration
SHORTLINK_BASE_URL=http://localhost:5173
SHORTLINK_SLUG_MIN=3
SHORTLINK_SLUG_MAX=32
SHORTLINK_DEFAULT_RANDOM_LEN=8
SHORTLINK_RESERVED_SLUGS=api,admin,r,login,register,me,health,verify-email,resend-verification,logout,refresh,docs,assets,static,favicon.ico,_next,robots.txt,sitemap.xml
SHORTLINK_BLOCK_PRIVATE_HOSTS=false
SHORTLINK_CLICK_TTL_MS=0
